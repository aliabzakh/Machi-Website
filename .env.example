# Copy this file to `.env.local` and fill in your Supabase project's values.
# Supabase Dashboard → Project Settings → API.
#
# These are PUBLIC values (they ship in the browser bundle). Security comes from
# the Row Level Security rules in supabase/schema.sql, not from hiding these.
# Never put the `service_role` secret here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key
